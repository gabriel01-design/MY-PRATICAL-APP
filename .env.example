# ---------------------------------------------------------------------------
# Supabase
# Leave both values blank to run the app in local demo mode (localStorage).
# Set both to run against Supabase (see README → "Connecting Supabase").
# Newer projects use a publishable key (sb_publishable_...); older ones an
# anon key (JWT). Either env name below is accepted.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (newer projects)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Or anon key (older projects) — you only need one of the two.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Staff access code
# The shared code that unlocks /admin and /kitchen. Store it as a secret and
# share it only with staff. Leave blank to use the built-in default.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ADMIN_ACCESS_CODE=
